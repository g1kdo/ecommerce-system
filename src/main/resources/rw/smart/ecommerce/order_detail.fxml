<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="detailRoot" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="rw.smart.ecommerce.controller.OrderDetailController"
      spacing="12" prefWidth="620" prefHeight="440">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="titleLabel" text="Order" styleClass="screen-title"/>

    <GridPane hgap="14" vgap="6">
        <Label text="Placed on" styleClass="field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="dateLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Status" styleClass="field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="statusLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Total" styleClass="field-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="totalLabel" styleClass="total-label" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Items" styleClass="panel-title"/>
    <TableView fx:id="itemTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="productColumn" text="Product" prefWidth="230"/>
            <TableColumn fx:id="quantityColumn" text="Qty" prefWidth="70"/>
            <TableColumn fx:id="unitPriceColumn" text="Unit price" prefWidth="120"/>
            <TableColumn fx:id="lineTotalColumn" text="Line total" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeButton" text="Close" onAction="#onClose"/>
    </HBox>

</VBox>
