<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="rw.smart.ecommerce.controller.OrderListController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="0" bottom="10" left="0"/>
            </padding>
            <VBox spacing="2">
                <Label text="My Orders" styleClass="screen-title"/>
                <Label text="Every order you have placed, newest first." styleClass="screen-subtitle"/>
            </VBox>
            <HBox fx:id="toolbar" spacing="10" alignment="CENTER_LEFT">
                <Label text="Status" styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" prefWidth="160"/>
                <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Change to" styleClass="field-label"/>
                <ComboBox fx:id="newStatusComboBox" prefWidth="150"/>
                <Button fx:id="updateStatusButton" text="Update Status" onAction="#onUpdateStatus"/>
                <Button fx:id="viewDetailsButton" text="View Details" onAction="#onViewDetails"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="orderTable">
            <columns>
                <TableColumn fx:id="orderIdColumn" text="Order #" prefWidth="90"/>
                <TableColumn fx:id="orderDateColumn" text="Placed on" prefWidth="180"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="140"/>
                <TableColumn fx:id="totalColumn" text="Total" prefWidth="130"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox fx:id="footerBar" spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="0" bottom="0" left="0"/>
            </padding>
            <Label fx:id="summaryLabel"/>
        </HBox>
    </bottom>

</BorderPane>
