# ============================================================
# Smart E-Commerce System — GraphQL schema
# ============================================================
# Timestamps are exposed as ISO-8601 strings so no custom scalar is needed;
# money is a Float on the wire and BigDecimal everywhere behind it.

type Category {
    id: ID!
    name: String!
    description: String
}

type Product {
    id: ID!
    name: String!
    description: String
    price: Float!
    # Generated server-side as CAT-YYMM-NNNNN; read-only.
    sku: String!
    category: Category!
    stockQuantity: Int!
    createdAt: String!

    # Resolved only when asked for, and batched across the whole page by
    # @BatchMapping - one MongoDB aggregation per query rather than one per
    # product. See ReviewGraphQLController.reviewSummary.
    reviewSummary: ReviewSummary!

    # Customers-also-bought, from order history rather than the catalogue.
    # A field rather than a root query because it belongs to a product, and
    # because it then costs nothing unless a client asks for it.
    relatedProducts(limit: Int = 5): [RelatedProduct!]!
}

type ProductPage {
    content: [Product!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    last: Boolean!
}

type User {
    id: ID!
    username: String!
    email: String!
    fullName: String!
    phone: String
    role: UserRole!
    createdAt: String!
}

type OrderItem {
    id: ID!
    productId: ID!
    productName: String!
    quantity: Int!
    unitPrice: Float!
    lineTotal: Float!
}

type Order {
    id: ID!
    userId: ID!
    status: OrderStatus!
    totalAmount: Float!
    orderDate: String!
    items: [OrderItem!]!
}

type Review {
    id: ID!
    productId: ID!
    userId: ID!
    rating: Int!
    title: String
    comment: String
    tags: [String!]!
    helpfulVotes: Int!
    createdAt: String!
}

type ReviewSummary {
    productId: ID!
    reviewCount: Int!
    averageRating: Float!
}

enum UserRole {
    ADMIN
    CUSTOMER
}

enum OrderStatus {
    PENDING
    PAID
    SHIPPED
    DELIVERED
    CANCELLED
}


type OrderPage {
    content: [Order!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    last: Boolean!
}

type UserPage {
    content: [User!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    last: Boolean!
}

type CategoryPage {
    content: [Category!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    last: Boolean!
}

type LowStockPage {
    content: [LowStockProduct!]!
    page: Int!
    size: Int!
    totalElements: Int!
    totalPages: Int!
    last: Boolean!
}

type LowStockProduct {
    productId: ID!
    sku: String!
    name: String!
    categoryName: String!
    quantity: Int!
}

type RelatedProduct {
    productId: ID!
    productName: String!
    timesBoughtTogether: Int!
}

# ---------- Reporting ----------
# Every field of SalesReport and CatalogueReport is resolved on demand. A
# dashboard asking only for totalRevenue does not run the daily group-by, and one
# asking for four panels gets them in one round trip instead of four REST calls.
# That is the case section 6.3 of the performance report measured GraphQL winning.

type DailySales {
    day: String!
    orderCount: Int!
    revenue: Float!
    averageOrderValue: Float!
}

type OrderStatusSummary {
    status: OrderStatus!
    orderCount: Int!
    revenue: Float!
}

type TopProduct {
    productId: ID!
    productName: String!
    sku: String!
    unitsSold: Int!
    revenue: Float!
}

type CategoryRevenue {
    categoryId: ID!
    name: String!
    orderCount: Int!
    unitsSold: Int!
    revenue: Float!
}

type CategorySummary {
    categoryId: ID!
    name: String!
    productCount: Int!
    # Null for a category with no products: it has no cheapest item, and saying
    # zero would claim it sells something free.
    minPrice: Float
    maxPrice: Float
    averagePrice: Float
}

type CustomerSpend {
    userId: ID!
    fullName: String!
    email: String!
    orderCount: Int!
    totalSpent: Float!
}

type MissedDemand {
    # No product name: the shortfall audit carries no foreign key, so the product
    # may since have been deleted. Inventing a name for one that is gone would be
    # worse than reporting the id.
    productId: ID!
    occurrences: Int!
    unitsMissed: Int!
}

type StockShare {
    productId: ID!
    sku: String!
    name: String!
    quantity: Int!
    shareOfCategoryStock: Float!
}

type SalesReport {
    totalRevenue: Float!
    daily: [DailySales!]!
    byStatus: [OrderStatusSummary!]!
    topProducts(limit: Int = 10): [TopProduct!]!
    revenueByCategory: [CategoryRevenue!]!
    topCustomers(limit: Int = 10): [CustomerSpend!]!
    lapsedCustomers(since: String, limit: Int = 10): [CustomerSpend!]!
}

type CatalogueReport {
    categories: [CategorySummary!]!
    lowStock(threshold: Int = 5, page: Int = 0, size: Int = 20): LowStockPage!
    stockDistribution(categoryId: ID!): [StockShare!]!
    missedDemand(since: String, limit: Int = 10): [MissedDemand!]!
}

# ---------- Inputs ----------

input ProductFilterInput {
    keyword: String
    categoryId: ID
    minPrice: Float
    maxPrice: Float
    page: Int = 0
    size: Int = 20
    sortBy: String = "id"
    direction: String = "ASC"
}

input ProductInput {
    name: String!
    description: String
    price: Float!
    # No sku: it is generated server-side as CAT-YYMM-NNNNN and is read-only.
    categoryId: ID!
    initialStock: Int = 0
}

input CategoryInput {
    name: String!
    description: String
}

input UserInput {
    username: String!
    email: String!
    password: String!
    fullName: String!
    phone: String
    role: UserRole!
}

input OrderItemInput {
    productId: ID!
    quantity: Int!
}

input OrderInput {
    userId: ID!
    items: [OrderItemInput!]!
}

input ReviewInput {
    productId: ID!
    userId: ID!
    rating: Int!
    title: String
    comment: String
    tags: [String!]
}

# ---------- Operations ----------

type Query {
    # Customer catalogue
    products(filter: ProductFilterInput): ProductPage!
    product(id: ID!): Product!
    categories: [Category!]!
    category(id: ID!): Category!

    # Reviews
    reviewsByProduct(productId: ID!, page: Int = 0, size: Int = 20): [Review!]!
    reviewSummary(productId: ID!): ReviewSummary!

    # Orders
    ordersByUser(userId: ID!): [Order!]!
    order(id: ID!): Order!

    # Paginated order views. ordersByUser above returns a whole history in one
    # response and has no upper bound; prefer orderHistory.
    orderHistory(userId: ID!, status: OrderStatus, page: Int = 0, size: Int = 20,
        sortBy: String = "orderDate", direction: String = "DESC"): OrderPage!
    orders(status: OrderStatus, page: Int = 0, size: Int = 20,
        sortBy: String = "orderDate", direction: String = "DESC"): OrderPage!

    # Administration
    users: [User!]!
    user(id: ID!): User!
    searchUsers(keyword: String, page: Int = 0, size: Int = 20,
        sortBy: String = "id", direction: String = "ASC"): UserPage!
    searchCategories(keyword: String, page: Int = 0, size: Int = 20,
        sortBy: String = "name", direction: String = "ASC"): CategoryPage!

    # Reporting. Dates are ISO-8601 strings (YYYY-MM-DD), matching the
    # convention the rest of this schema uses for timestamps. Both default to
    # the last 30 days.
    salesReport(from: String, to: String): SalesReport!
    catalogueReport: CatalogueReport!
}

type Mutation {
    createProduct(input: ProductInput!): Product!
    updateProduct(id: ID!, input: ProductInput!): Product!
    deleteProduct(id: ID!): Boolean!

    createCategory(input: CategoryInput!): Category!
    updateCategory(id: ID!, input: CategoryInput!): Category!
    deleteCategory(id: ID!): Boolean!

    createUser(input: UserInput!): User!
    deleteUser(id: ID!): Boolean!

    adjustStock(productId: ID!, quantity: Int!): Int!

    placeOrder(input: OrderInput!): Order!
    updateOrderStatus(id: ID!, status: OrderStatus!): Order!

    addReview(input: ReviewInput!): Review!
    markReviewHelpful(id: ID!): Review!
    deleteReview(id: ID!): Boolean!
}
